# ─────────────────────────────────────────────────────────────────────
# POLLA MUNDIALISTA 2026 — Variables de Entorno
#
# 1. Copia este archivo y nómbralo: .env.local
# 2. Rellena los valores con tus claves
# 3. NUNCA subas el archivo .env.local a GitHub (ya está en .gitignore)
# ─────────────────────────────────────────────────────────────────────

# Firebase (obtén estos valores desde Firebase Console > Configuración del proyecto)
VITE_FIREBASE_API_KEY=TU_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=TU_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=TU_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=TU_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=TU_SENDER_ID
VITE_FIREBASE_APP_ID=TU_APP_ID

# football-data.org (regístrate gratis en https://www.football-data.org/)
VITE_FOOTBALL_API_KEY=TU_FOOTBALL_API_KEY
